{
  "manifest_version": 3,
  "name": "Agent Web Tweaks",
  "version": "0.1.0",
  "description": "按 URL 用 CSS / JS 自由定制任意网页，并把同一套能力交给任何 agent（MCP / HTTP / CLI）。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/tweaker.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Agent Web Tweaks",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/ui/studio.html",
    "open_in_tab": true
  },
  "commands": {
    "pick-element": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "拾取页面元素"
    }
  }
}
